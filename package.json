{
  "name": "erin-calendar",
  "version": "0.0.11",
  "description": "Personal calendar view for daily notes",
  "author": "Erin Skidds",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "lint": "svelte-check && eslint . --ext .ts",
    "build": "yarn lint && rollup -c",
    "test": "jest --runInBand",
    "test:watch": "yarn test -- --watch"
  },
  "dependencies": {
    "moment": "2.30.1",
    "obsidian": "1.13.1",
    "obsidian-calendar-ui": "0.3.12",
    "obsidian-daily-notes-interface": "0.9.5",
    "svelte": "3.59.2",
    "tslib": "2.1.0"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@rollup/plugin-commonjs": "28.0.9",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-typescript": "12.3.0",
    "@tsconfig/svelte": "1.0.10",
    "@types/jest": "29.5.14",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "rollup": "4.34.8",
    "rollup-plugin-svelte": "7.1.0",
    "svelte-check": "3.8.6",
    "svelte-jester": "3.0.0",
    "svelte-preprocess": "5.1.4",
    "ts-jest": "29.2.5",
    "typescript": "5.4.5"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "src/(.*)": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.svelte$": [
        "svelte-jester",
        {
          "preprocess": true
        }
      ],
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    },
    "moduleFileExtensions": [
      "js",
      "ts",
      "svelte"
    ]
  },
  "resolutions": {
    "obsidian": "1.13.1",
    "moment": "2.30.1"
  }
}
