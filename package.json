{
  "name": "erin-calendar",
  "version": "0.0.7",
  "description": "Personal calendar view for daily notes",
  "author": "Erin Skidds",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "lint": "svelte-check && eslint . --ext .ts",
    "build": "npm run lint && rollup -c",
    "test": "jest --passWithNoTests",
    "test:watch": "yarn test -- --watch"
  },
  "dependencies": {
    "obsidian": "1.13.1",
    "obsidian-calendar-ui": "0.3.12",
    "obsidian-daily-notes-interface": "0.9.0",
    "svelte": "3.35.0",
    "tslib": "2.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "28.0.9",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-typescript": "12.3.0",
    "@tsconfig/svelte": "1.0.10",
    "@types/jest": "26.0.22",
    "@types/moment": "2.13.0",
    "@typescript-eslint/eslint-plugin": "4.20.0",
    "@typescript-eslint/parser": "4.20.0",
    "eslint": "7.23.0",
    "jest": "26.6.3",
    "moment": "2.29.1",
    "rollup": "4.34.8",
    "rollup-plugin-svelte": "7.1.0",
    "svelte-check": "1.3.0",
    "svelte-jester": "1.3.2",
    "svelte-preprocess": "4.7.0",
    "ts-jest": "26.5.4",
    "typescript": "4.2.3"
  },
  "jest": {
    "moduleNameMapper": {
      "src/(.*)": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.svelte$": [
        "svelte-jester",
        {
          "preprocess": true
        }
      ],
      "^.+\\.ts$": "ts-jest"
    },
    "moduleFileExtensions": [
      "js",
      "ts",
      "svelte"
    ]
  },
  "resolutions": {
    "obsidian": "1.13.1",
    "moment": "2.30.1"
  }
}
