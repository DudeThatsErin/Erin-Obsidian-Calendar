{
  "extends": "@tsconfig/svelte/tsconfig.json",

  "include": ["src/**/*"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "types": ["node", "svelte", "jest"],
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"]
    },
    "strict": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "ignoreDeprecations": "5.0"
  }
}
