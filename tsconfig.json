{
  "extends": "@tsconfig/svelte/tsconfig.json",

  "include": ["src/**/*"],
  "exclude": ["node_modules/*", "src/testUtils/**"],
  "compilerOptions": {
    "types": ["node", "svelte", "jest"],
    "baseUrl": ".",
    "paths": {
      "src": ["src/*"]
    },
    "strict": false,
    "verbatimModuleSyntax": false,
    "ignoreDeprecations": "5.0",
    "skipLibCheck": true,
    "strict": false,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true
  }
}
